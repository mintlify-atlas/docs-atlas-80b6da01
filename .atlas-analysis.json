  "keyFeatures": [
    "AI-generated personalized 4-week learning plans based on Moodle data and soft skills assessments",
    "Holistic growth: integrates soft skills (emotional intelligence, communication) into technical reinforcement",
    "Team Leader analytics dashboard with proactive at-risk student detection",
    "Hybrid Node.js (API Gateway) + Python/FastAPI (AI microservice) architecture",
    "AI-powered focus cards, chat assistant, exercises, and resource search",
    "Multi-role system: Coders and Team Leaders with role-based access control",
    "Social authentication (Google, GitHub) and email OTP verification",
    "PostgreSQL (Supabase) with custom enums for roles, risk levels, and AI agents"
  ],
